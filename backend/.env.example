# Copy to .env for local development. Never commit credentials.
# Signs login tokens (JWT). Generate once; changing it signs everyone out.
# env/bin/python -c 'import secrets; print(secrets.token_urlsafe(48))'
AUTH_JWT_SECRET=
# How long a login lasts.
AUTH_TOKEN_TTL_HOURS=12
# Sign-in attempts allowed per client address per minute.
AUTH_LOGIN_ATTEMPTS_PER_MINUTE=10
# Reverse proxies in front of the API that append to X-Forwarded-For (0 for local
# development). Too low and all clients share one sign-in limit; too high and a caller
# can evade it with a forged header.
AUTH_TRUSTED_PROXY_HOPS=0
# The first user registers in the browser and registers the others there. From backend/,
# env/bin/python -m app.auth.users add you@example.com also creates or resets one.
# Encrypts the GitHub App private key saved in the GitHub tab: generate once and keep
# stable across API restarts.
# env/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Store/back up this key separately from PostgreSQL; losing it requires reconnecting GitHub.
GITHUB_TOKEN_ENCRYPTION_KEY=
# Exact browser origins permitted to change the shared GitHub connection. No wildcard.
GITHUB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
# Public address of POST /connectors/github/events, set on a manifest app's webhook by a
# connection check. Empty: derived from the request and its X-Forwarded-Prefix/-Proto.
GITHUB_WEBHOOK_URL=
# Seconds between the checks a waiting delivery makes of whether its pull request was
# merged or closed, besides the pull_request webhook (60 to 86400).
PULL_REQUEST_CHECK_INTERVAL_SECONDS=3600
# The OpenAI endpoint (base URL, API key, display name) is set up by the administrator on
# the Settings page; OPENAI_BASE_URL is not read. This key encrypts the saved API key:
# env/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Keep it stable and apart from PostgreSQL; losing it means entering the API key again.
SETTINGS_ENCRYPTION_KEY=
# Used only by Pi for its openai/* models.
OPENAI_API_KEY=
# Select adapter, model ID and thinking level per workflow in the Settings page.
# Values are stored in PostgreSQL and apply to the next model run without a restart.
# Pi needs `pi` on the host PATH; agent images install it themselves.
# Pi configuration directory (default: Pi's PI_CODING_AGENT_DIR, else ~/.pi/agent). Host
# model calls run Pi against it, and coding-agent containers get its
# auth.json mounted read-write, so refreshed tokens are kept, and its models.json
# read-only. Model and thinking selections come from the saved workflow settings. Its
# containers/ subdirectory, created on demand, is the Pi directory all containers share.
# The agent's shell can read these credentials.
# The API refreshes its OAuth tokens every 10 minutes when under 30 minutes remain.
PI_CREDENTIALS_DIR=
# Enable only for a dedicated credential directory visible at the same absolute
# path to workers and their Docker daemon. Coolify sets this and mounts its volume.
# Shares the whole directory with Pi agents, including the auth refresh lock.
PI_CREDENTIALS_SHARED=false
# Claude uses its own host login or these credentials. Containers require one of these.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Context budget for OpenAI/Pi coding loops: old tool history becomes a checkpoint.
# 0 disables application compaction. Claude manages its own context and compaction.
AGENT_CONTEXT_TOKENS=64000
# Contracts above this many characters reach coding agents as an index plus read-only
# files they query, instead of being embedded whole.
CONTRACT_EMBED_CHARS=60000

# S3-compatible storage every worker shares, addressed path-style: the provider
# conversations (Claude's native session; OpenAI, Gemini and Pi messages with their tool
# calls) a conversation resumes on its next turn, under conversations/ in the bucket,
# which must exist. Without it every turn starts anew from the session's messages.
S3_ENDPOINT_URL=https://s3.zikasak.uk
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://langfuse.zikasak.uk
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_SAMPLE_RATE=1.0
# Prompt, document, source-code and tool content are excluded unless opted in.
# Opt in only for data approved for storage in your Langfuse project.
APP_TRACE_CONTENT_ENABLED=false
# Optional deployment version (commit SHA or release tag).
LANGFUSE_RELEASE=

# Deterministic checks in place of parts of the code review (plans/deterministic-checks.md).
# Each is off until compared with the reviews without it; true enables it.
# Later review rounds skip files an earlier round judged clean and nothing changed since.
REVIEW_SKIP_SETTLED=false
# Regression tests must name the criteria they prove (`requirement: FR-…`); the host
# answers a regression review with the gaps before any reviewer runs.
REVIEW_REQUIREMENT_TAGS=false
# The host checks a Python seam's diff, and skips the review of a minimal one.
REVIEW_SEAM_CHECKS=false
# gitleaks (and ruff for Python) results on the changed lines reach the delivery review.
REVIEW_STATIC_CHECKS=false
