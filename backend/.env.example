# Copy to .env for local development. Never commit credentials.
# GitHub connector encryption key: generate once and keep stable across API restarts.
# env/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Store/back up this key separately from PostgreSQL; losing it requires reconnecting GitHub.
GITHUB_TOKEN_ENCRYPTION_KEY=
# Exact browser origins permitted to change the shared GitHub connection. No wildcard.
GITHUB_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
OPENAI_API_KEY=
OPENAI_MODEL=ddalcu/Qwen3.8-27B-MLX-Serve-4bit
OPENAI_BASE_URL=http://localhost:1234/v1
# Set to "pi" to make model calls through the Pi CLI, with Pi's own credentials, instead
# of the provider above. The host needs `pi` on PATH; agent images install it themselves.
LLM_HARNESS=
# Set to "claude" to make them through Claude Code (the Claude Agent SDK, which bundles
# the CLI) with Claude Code's credentials: on the host its own login, or
# ANTHROPIC_API_KEY / CLAUDE_CODE_OAUTH_TOKEN (from `claude setup-token`) below.
# Coding-agent containers cannot use the host login and need one of those two set.
# Pi model pattern such as openai/gpt-4o or sonnet:high; empty uses Pi's default model.
PI_MODEL=
# Pi configuration directory (default: Pi's PI_CODING_AGENT_DIR, else ~/.pi/agent). Host
# model calls run Pi against it, and coding-agent containers get its
# auth.json mounted read-write, so refreshed tokens are kept, and its models.json
# read-only; without PI_MODEL they use the default model from its settings.json. Its
# containers/ subdirectory, created on demand, is the Pi directory all containers share.
# The agent's shell can read these credentials.
PI_CREDENTIALS_DIR=
# Claude model ID or alias such as claude-opus-5-5 or sonnet; empty uses Claude Code's
# default model.
CLAUDE_MODEL=
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Context window of OPENAI_MODEL in tokens. Coding agents replace their oldest tool
# history with a checkpoint as they approach it; 0 disables that.
AGENT_CONTEXT_TOKENS=64000
# Contracts above this many characters reach coding agents as an index plus read-only
# files they query, instead of being embedded whole.
CONTRACT_EMBED_CHARS=60000

LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://langfuse.zikasak.uk
LANGFUSE_TRACING_ENABLED=true
LANGFUSE_TRACING_ENVIRONMENT=development
LANGFUSE_SAMPLE_RATE=1.0
# Prompt, document, source-code and tool content are excluded unless opted in.
# Opt in only for data approved for storage in your Langfuse project.
APP_TRACE_CONTENT_ENABLED=false
# Optional deployment version (commit SHA or release tag).
LANGFUSE_RELEASE=
