from dataclasses import dataclass
from datetime import timedelta
from typing import Any

# How long a finished delivery that has a pull request still open waits for the user's
# next decision or a mention before it closes on its own: 14 days.
TASK_IDLE_TIMEOUT: timedelta

# How often a delivery that waits after its push checks the state of its pull request
# (the `pull_request_state` activity): the configured interval, one hour unless the
# instance configures another.
PULL_REQUEST_CHECK_INTERVAL: timedelta


def delivery_id(session_id: str) -> str:
    """The workflow ID of the delivery of session `session_id`: 'delivery-' followed by
    the session ID."""
    ...


@dataclass
class TaskSpec:
    """The task a delivery carries out. `session_id` is the session it belongs to (its
    pushed branch and pull request are that session's); `repository` is the repository
    selection, a dict with at least 'full_name' ('owner/name') and 'branch'; `checkout` is
    the session's checkout ({'commit': ...}); without one nothing is pushed. `kind` is
    'new_service', 'api_change', 'bugfix' or 'docs'. `onboarding` marks an onboarding's
    delivery, and `architecture_only` one of an onboarding that adds only the
    architecture (`architecture`, `architecture_structure`), pushed without tests,
    verification or code review."""
    session_id: str
    requirements: list[Any]
    requirements_document: str
    api: Any
    document_id: str | None = ...
    kind: str | None = ...
    brief: Any | None = ...
    language: str | None = ...
    repository: Any | None = ...
    checkout: Any | None = ...
    onboarding: bool = ...
    architecture: str | None = ...
    architecture_structure: dict[str, Any] | None = ...
    architecture_only: bool = ...


@dataclass
class DeliveryProgress:
    """Each stage's result or error, as the session API reports them. `publication` is
    the push ({'branch', 'commit', 'url', 'ignored', 'ignored_count', 'verified'}) and
    `publication_status` its step; `pull_request` the pull request opened from the
    pushed branch ({'number', 'title', 'url', 'draft', 'base'}) and `pull_request_status`
    its step ('not_applicable', 'waiting', 'running', 'completed', 'skipped' or 'error',
    with `pull_request_error` saying why it could not be opened). `open_findings` is the
    open-review-findings flag, raised for the user to accept the findings or give
    instructions; `findings_acceptance` records an acceptance ({'accepted_at',
    'accepted_by'})."""
    code: dict[str, Any] | None = ...
    code_error: str | None = ...
    implementation: dict[str, Any] | None = ...
    implementation_error: str | None = ...
    tests: dict[str, Any] | None = ...
    tests_error: str | None = ...
    component_tests: dict[str, Any] | None = ...
    component_tests_error: str | None = ...
    documentation: dict[str, Any] | None = ...
    documentation_error: str | None = ...
    routing: dict[str, Any] | None = ...
    routing_error: str | None = ...
    routing_status: str = ...
    seam: dict[str, Any] | None = ...
    seam_error: str | None = ...
    seam_status: str = ...
    seam_reviews: list[Any] = ...
    baseline: Any | None = ...
    baseline_error: str | None = ...
    baseline_status: str = ...
    test_reviews: list[Any] = ...
    component_baseline: Any | None = ...
    component_verification: Any | None = ...
    verification: Any | None = ...
    verification_error: str | None = ...
    verification_status: str = ...
    existing_tests: Any | None = ...
    repairs: list[Any] = ...
    publication: Any | None = ...
    publication_error: str | None = ...
    publication_status: str = ...
    agent_questions: list[Any] = ...
    reviews: list[Any] = ...
    review_error: str | None = ...
    correction_failed: bool = ...
    open_findings: bool = ...
    findings_acceptance: Any | None = ...
    pull_request: Any | None = ...
    pull_request_error: str | None = ...
    pull_request_status: str = ...
    pull_request_text_error: str | None = ...
    mentions: list[Any] = ...
    existing_code_changed: bool = ...


@dataclass
class DeliveryState:
    """What a run of a delivery starts from and what its `get_state` query reports.
    `record_only` makes a run do nothing but record the state and wait, as a run started
    from a delivery that already waited after its push does; `instructions` are the
    user's instructions about open review findings, which start a fix round; `waiting`
    is raised while the run waits for the user's next decision after its work."""
    spec: TaskSpec
    progress: DeliveryProgress = ...
    retry_stage: str | None = ...
    instructions: str | None = ...
    record_only: bool = ...
    mention: int | None = ...
    mention_type: str | None = ...
    declined_routes: dict[str, Any] | None = ...
    mention_queue: list[Any] = ...
    documentation_fix: str | None = ...
    code_fix: dict[str, Any] | None = ...
    restore_tests: list[Any] = ...
    kept_tests: list[Any] = ...
    waiting: bool = ...
