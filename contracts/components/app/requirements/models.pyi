from dataclasses import dataclass
from typing import Any


@dataclass
class RequirementsState:
    """A requirements session. `messages` is the conversation, each {'role': 'user' or
    'assistant', 'content': str, optional 'questions'}; `kind` is 'new_service',
    'api_change', 'bugfix' or 'docs'; `status` is 'preparing', 'interviewing',
    'turn_running', 'finalizing', 'completed' or 'failed'; `repository` is the
    repository selection ({'provider': 'github', 'repository_id', 'full_name',
    'html_url', 'private', 'branch'}) and `checkout` its checkout ({'commit': ...}): a
    session with a repository but no checkout checks it out first. `document` is the
    written requirements document ({'document_id', ...})."""
    messages: list[Any] = ...
    requirements: list[Any] = ...
    kind: str | None = ...
    retired: list[Any] = ...
    status: str = ...
    document: dict[str, Any] | None = ...
    error: str | None = ...
    forked_from: Any | None = ...
    repository: Any | None = ...
    checkout: Any | None = ...
    contract: dict[str, Any] | None = ...
    contract_commit: str | None = ...
    api_design_session_id: str | None = ...
    architecture_session_id: str | None = ...
