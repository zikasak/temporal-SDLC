from dataclasses import dataclass
from typing import Any

from app.api_design.models import ApiDesignState


@dataclass
class ArchitectureState:
    """An architecture session of the requirements session `source_session_id`, the
    root of its flow. `api_design_session_id` is set once the session handed the task on
    to its API design."""
    source_session_id: str = ...
    kind: str = ...
    requirements: list[Any] = ...
    requirements_document: str = ...
    change_document: str = ...
    existing_architecture: str | None = ...
    existing_structure: Any | None = ...
    messages: list[Any] = ...
    structure: Any | None = ...
    skip_proposal: Any | None = ...
    skip_declined: bool = ...
    status: str = ...
    document: dict[str, Any] | None = ...
    error: str | None = ...
    forked_from: Any | None = ...
    repository: Any | None = ...
    checkout: Any | None = ...
    api_design_session_id: str | None = ...
    design: ApiDesignState | None = ...
    # The task flow the session belongs to, the session it started next, and `pending`
    # while the flow has not started it.
    task_flow_id: str | None = ...
    next_session_id: str | None = ...
    pending: bool = ...


@dataclass
class ArchitectureResult:
    """What a finalized or skipped architecture session hands on: the ID and the state of
    the API design its requirements session starts next."""
    api_design_session_id: str
    design: ApiDesignState
